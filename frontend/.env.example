# ==============================================================================
# Fiorify Enterprise SAP Modernization Platform — Frontend Environment Template
# File: frontend/.env.example
# Security Notice: Copy to .env and customize. Never commit real credentials to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT & WORKSPACE
# ------------------------------------------------------------------------------
VITE_APP_ENV=LOCAL_DEMO # Options: LOCAL_DEMO | STAGING | PRODUCTION
VITE_APP_TITLE=Fiorify — SAP Fiori Modernization Tool
VITE_WORKSPACE_NAME=Enterprise Modernization Workspace

# ------------------------------------------------------------------------------
# 2. BACKEND API CONNECTIVITY
# ------------------------------------------------------------------------------
# In development, leave blank to use the Vite proxy (/api -> http://localhost:4004)
# In standalone/production, set to the absolute backend API URL (e.g. https://api.fiorify.corp)
VITE_API_BASE_URL=

# ------------------------------------------------------------------------------
# 3. DEMO SIMULATION SETTINGS
# ------------------------------------------------------------------------------
VITE_ENABLE_MOCK_DELAY=true
VITE_MOCK_DELAY_MS=300

# ------------------------------------------------------------------------------
# 4. SAP SYSTEM DEFAULTS
# ------------------------------------------------------------------------------
VITE_DEFAULT_SAP_SYSTEM_ID=S21
VITE_DEFAULT_SAP_SYSTEM_NAME=SAP S/4HANA 2023 FPS01
VITE_DEFAULT_SAP_CLIENT=200
VITE_DEFAULT_SAP_BASIS_RELEASE=758
VITE_DEFAULT_SAP_SOFTWARE_COMPONENT=S4CORE 108

{
  "name": "fiorify-enterprise-platform",
  "version": "1.0.0",
  "description": "Fiorify Enterprise SAP Modernization & Fiori Application Platform",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x",
    "npm": "10.x"
  },
  "scripts": {
    "start": "node backend/src/server.js",
    "build:frontend": "npm --prefix frontend run build",
    "build": "npm --prefix frontend run build",
    "check:backend": "npm --prefix backend run check",
    "check:frontend": "npm --prefix frontend run check",
    "typecheck": "npm --prefix frontend run typecheck",
    "check": "npm run check:backend && npm run check:frontend",
    "test:backend": "node --test --test-concurrency=1 backend/test/",
    "test:frontend": "npm --prefix frontend test",
    "test": "npm run test:backend && npm run test:frontend"
  },
  "author": "Fiorify Engineering Team",
  "license": "UNLICENSED",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@neon/config": "^1.14.2",
    "@neon/env": "^2.1.5",
    "@sap-cloud-sdk/connectivity": "^3.26.4",
    "@sap-cloud-sdk/http-client": "^3.26.4",
    "@sap-ux/fiori-mcp-server": "1.15.24",
    "pg": "^8.23.1",
    "xlsx": "^0.18.5"
  }
}

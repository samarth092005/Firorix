# Fiorify Backend Environment Configuration Template (.env.example)
# Copy to .env and customize. Never commit real credentials.

PORT=4004
NODE_ENV=development
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SAP Gateway, ADT & S/4HANA Landscape Configuration (Sprint S2)
SAP_SYSTEM_ID=S21
SAP_CLIENT=200
SAP_CONNECTIVITY_MODE=DIRECT_HTTP # Options: DIRECT_HTTP | BTP_DESTINATION | MOCK
SAP_BASE_URL=http://127.0.0.1:8000
SAP_GATEWAY_PATH=/sap/opu/odata/IWFND/CATALOGSERVICE;v=2/ServiceCollection
SAP_ADT_PATH=/sap/bc/adt/discovery
SAP_AUTH_TYPE=BASIC # Options: BASIC | X509 | OAUTH2
SAP_USER=
SAP_PASSWORD=
SAP_DESTINATION_NAME=S21
SAP_TLS_REJECT_UNAUTHORIZED=true # Strict TLS verification (never disable in production)
SAP_READ_ONLY_ENFORCED=true # Strictly blocks mutating operations (POST, PUT, DELETE, PATCH)
SAP_TIMEOUT_MS=15000
Fiorify_ADMIN_SECRET=change_me_to_a_secure_random_string

# Live SAP Direct Host (Legacy alias for SAP_BASE_URL)
SAP_URL_OVERRIDE=http://127.0.0.1:8000

# BTP Connectivity (Optional)
BTP_DESTINATION_CLIENT_ID=
BTP_DESTINATION_CLIENT_SECRET=
BTP_DESTINATION_URL=
BTP_DESTINATION_TOKEN_URL=
LOCAL_CONNECTIVITY_PROXY=

# SAP Fiori MCP Server Integration (MCP-01 + MCP-02)
MCP_ENABLED=false
MCP_SERVER_PACKAGE=@sap-ux/fiori-mcp-server
MCP_SERVER_VERSION=1.15.24
MCP_TRANSPORT=stdio
MCP_STARTUP_TIMEOUT_MS=30000
MCP_TOOL_TIMEOUT_MS=60000
MCP_RECONNECT_MAX_ATTEMPTS=3
MCP_AUTO_CONNECT=false
MCP_LOG_LEVEL=info
# MCP_EXECUTABLE_PATH=

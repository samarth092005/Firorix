# ==============================================================================
# Fiorify — SAP Fiori Modernization Tool — Backend Environment Template
# File: backend/.env.example
# Security Notice: Copy to .env and customize. Never commit real credentials to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER RUNTIME
# ------------------------------------------------------------------------------
PORT=4004
NODE_ENV=development # Options: development | test | production
LOG_LEVEL=info        # Options: debug | info | warn | error
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# 2. PERSISTENCE & DATABASE (PostgreSQL)
# ------------------------------------------------------------------------------
# Primary connection string (preferred in Cloud Foundry / Container environments)
DATABASE_URL=postgres://fiorify_user:change_me_password@localhost:5432/fiorify_db

# Granular PostgreSQL parameters (used if DATABASE_URL is not set)
PGHOST=localhost
PGPORT=5432
PGDATABASE=fiorify_db
PGUSER=fiorify_user
PGPASSWORD=change_me_password

# Persistence mode: 'postgres' (recommended), 'embedded' (local dev only), 'memory' (fallback)
FIORIFY_PERSISTENCE=postgres
FIORIFY_ALLOW_EMBEDDED_PG=false # Set to true only on local workstations without Docker/PG

# ------------------------------------------------------------------------------
# 3. SECURITY & CRYPTOGRAPHY (Sprint 13.2 / Sprint 14.1 / Milestone 2 Auth)
# ------------------------------------------------------------------------------
# Master admin bearer token for privileged operations (Minimum 32 random characters)
FIORIFY_ADMIN_SECRET=change_me_to_a_cryptographically_secure_random_string_32_chars

# HMAC-SHA256 signing secret for artifact and deployment plan cryptographic approval
FIORIFY_SIGNING_SECRET=change_me_to_a_cryptographically_secure_signing_secret_32_chars

# Authentication provider selection: XSUAA | LOCAL | DEMO (or SAP_BTP_XSUAA | LOCAL_AUTH | DEMO_SANDBOX)
# In production (NODE_ENV=production), ONLY XSUAA is permitted. LOCAL and DEMO will fail-closed.
FIORIFY_AUTH_PROVIDER=LOCAL

# JWT Secret for LOCAL auth provider token signing & verification (min 32 chars in production)
FIORIFY_JWT_SECRET=change_me_to_a_cryptographically_secure_jwt_secret_32_chars

# Whether demo synthetic authentication is permitted (STRICTLY false in production)
FIORIFY_ALLOW_DEMO_AUTH=false

# Versioned signing keys JSON dictionary for key rotation (optional, defaults to FIORIFY_SIGNING_SECRET)
# Format: {"v1": "secret_v1_32_chars_min...", "v2": "secret_v2_32_chars_min..."}
FIORIFY_SIGNING_KEYS_JSON=
FIORIFY_SIGNING_KEY_VERSION=v1

# Whether to enforce strict token authentication (defaults to true in production)
FIORIFY_ENFORCE_AUTH=false

# ------------------------------------------------------------------------------
# 3b. OPTIONAL LOCAL DEV / TESTING CREDENTIALS (Strictly isolated from Production)
# ------------------------------------------------------------------------------
# In development/test mode, passwords for seeded personas can be injected here.
# Never configure these in production (LOCAL_AUTH is strictly blocked in production).
FIORIFY_DEV_ADMIN_PASSWORD=
FIORIFY_DEV_CONSULTANT_PASSWORD=
FIORIFY_DEV_APPROVER_PASSWORD=
FIORIFY_DEV_ARCHITECT_PASSWORD=
FIORIFY_DEV_REQUESTER_PASSWORD=
FIORIFY_DEV_VIEWER_PASSWORD=

# ------------------------------------------------------------------------------
# 4. SAP S/4HANA LANDSCAPE & CONNECTIVITY (Sprint S2 / S3)
# ------------------------------------------------------------------------------
SAP_SYSTEM_ID=S21
SAP_CLIENT=200
SAP_CONNECTIVITY_MODE=DIRECT_HTTP # Options: DIRECT_HTTP | BTP_DESTINATION | MOCK

# Direct Gateway / ADT Base URL (used when SAP_CONNECTIVITY_MODE=DIRECT_HTTP)
SAP_BASE_URL=http://127.0.0.1:8000
SAP_GATEWAY_PATH=/sap/opu/odata/IWFND/CATALOGSERVICE;v=2/ServiceCollection
SAP_ADT_PATH=/sap/bc/adt/discovery

# Authentication type for direct connectivity: BASIC | X509 | OAUTH2
SAP_AUTH_TYPE=BASIC
SAP_USER=
SAP_PASSWORD=

# Outbound Security & Guardrails (Mandatory in all non-mock environments)
SAP_TLS_REJECT_UNAUTHORIZED=true # Strict TLS verification (never set to false in production)
SAP_READ_ONLY_ENFORCED=true      # Zero-mutation safety guardrail (strictly blocks POST/PUT/DELETE)
SAP_TIMEOUT_MS=15000             # Outbound request timeout in milliseconds

# SSRF Protection Allowlist: Comma-separated list of permitted SAP hostnames/IPs
ALLOWED_SAP_HOSTS=127.0.0.1,localhost,s21.corp.internal

# ------------------------------------------------------------------------------
# 5. SAP BTP DESTINATION & CONNECTIVITY SERVICE (Optional BTP Managed Mode)
# ------------------------------------------------------------------------------
SAP_DESTINATION_NAME=S21
BTP_DESTINATION_URL=
BTP_DESTINATION_CLIENT_ID=
BTP_DESTINATION_CLIENT_SECRET=
BTP_DESTINATION_TOKEN_URL=
LOCAL_CONNECTIVITY_PROXY=

# ------------------------------------------------------------------------------
# 6. SAP BTP XSUAA SERVICE (Production Enterprise Identity)
# ------------------------------------------------------------------------------
XSUAA_APP_NAME=fiorify-core
XSUAA_URL=
XSUAA_CLIENT_ID=
XSUAA_CLIENT_SECRET=
XSUAA_IDENTITY_ZONE=
XSUAA_VERIFICATION_KEY=

# ------------------------------------------------------------------------------
# 7. SAP FIORI MCP SERVER INTEGRATION (Model Context Protocol)
# ------------------------------------------------------------------------------
MCP_ENABLED=false
MCP_SERVER_PACKAGE=@sap-ux/fiori-mcp-server
MCP_SERVER_VERSION=1.15.24
MCP_TRANSPORT=stdio
MCP_STARTUP_TIMEOUT_MS=30000
MCP_TOOL_TIMEOUT_MS=60000
MCP_RECONNECT_MAX_ATTEMPTS=3
MCP_AUTO_CONNECT=false
MCP_LOG_LEVEL=info

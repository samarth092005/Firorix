# Fiorify Backend Environment Configuration Template (.env.example)
# Copy to .env and customize. Never commit real credentials.

PORT=4004
NODE_ENV=development
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SAP Gateway and Landscape Credentials
SAP_DESTINATION_NAME=S21
SAP_CLIENT=200
SAP_TIMEOUT_MS=15000
Fiorify_ADMIN_SECRET=change_me_to_a_secure_random_string

# Live SAP Network Access (Optional)
SAP_URL_OVERRIDE=http://127.0.0.1:8000
SAP_USER=demo_user
SAP_PASSWORD=demo_password

# BTP Connectivity (Optional)
BTP_DESTINATION_CLIENT_ID=
BTP_DESTINATION_CLIENT_SECRET=
BTP_DESTINATION_URL=
BTP_DESTINATION_TOKEN_URL=
LOCAL_CONNECTIVITY_PROXY=

# SAP Fiori MCP Server Integration (MCP-01 + MCP-02)
MCP_ENABLED=false
MCP_SERVER_PACKAGE=@sap-ux/fiori-mcp-server
MCP_SERVER_VERSION=1.15.24
MCP_TRANSPORT=stdio
MCP_STARTUP_TIMEOUT_MS=30000
MCP_TOOL_TIMEOUT_MS=60000
MCP_RECONNECT_MAX_ATTEMPTS=3
MCP_AUTO_CONNECT=false
MCP_LOG_LEVEL=info
# MCP_EXECUTABLE_PATH=
